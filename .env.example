# =============================================
# BOT RIFAS CLUBE DO CHURRASCO - CONFIGURAÇÕES
# =============================================

# URL do Google Apps Script publicado (obrigatório)
SHEET_SCRIPT_URL=https://script.google.com/macros/s/SEU_SCRIPT_ID_AQUI/exec

# Link do grupo WhatsApp (botão 1)
GROUP_LINK=https://chat.whatsapp.com/FG1hAPfo12e8AJOydKTnKs

# Limite de envios por dia
DAILY_LIMIT=150

# Delay mínimo entre envios (em milissegundos) - 35 segundos
MIN_DELAY=35000

# Delay máximo entre envios (em milissegundos) - 250 segundos
MAX_DELAY=250000

# Horário de início dos envios (hora de Brasília)
START_HOUR=8

# Horário de fim dos envios (hora de Brasília)
END_HOUR=20

# Timer mensagem temporária em segundos
# 86400  = 24 horas
# 604800 = 7 dias
# 7776000 = 90 dias
DISAPPEARING_TIMER=7776000

# Nome do arquivo de log
LOG_FILE=logs/bot.log
